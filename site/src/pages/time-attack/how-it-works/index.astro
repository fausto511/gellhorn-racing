---
import Base from '../../../layouts/Base.astro';
import TimeAttackSubnav from '../../../components/TimeAttackSubnav.astro';
const base = import.meta.env.BASE_URL;

const steps = [
  {
    n: '01',
    title: 'Drive Your Lap',
    copy: "Set your fastest clean lap at Gellhorn International Raceway under the current Gellhorn Standard.",
    icon: 'M12 2 2 7l10 5 10-5-10-5Z M2 17l10 5 10-5 M2 12l10 5 10-5',
  },
  {
    n: '02',
    title: 'Save Your Proof',
    copy: 'Capture a screenshot of your results screen right after the lap. Want your run eligible for an official record? Record the full lap on video instead.',
    icon: 'M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
  },
  {
    n: '03',
    title: 'Get It Onto Your Phone',
    copy: 'On PS5, share the screenshot or clip to the PlayStation App so it is ready to upload from your phone or a browser.',
    icon: 'M17 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z M11 18h2',
  },
  {
    n: '04',
    title: 'Submit on the Site',
    copy: "Open Submit a Lap, fill in your run details, and send it in. Screenshot entries publish right away as provisional; video entries get a human check for verified status.",
    icon: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12',
  },
];
---
<Base
  title="How It Works — Gellhorn Time Attack"
  description="How to submit a lap for Gellhorn Time Attack: drive your lap, save proof, get it onto your phone, and submit it on the site."
  section="time-attack"
>
  <TimeAttackSubnav active="how-it-works" />
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Gellhorn Time Attack</p>
      <h1 class="display page-title">How It Works</h1>
      <p class="page-lede">From a fast lap to a listed time in four steps. GTA 6 hasn't launched yet — this is the path the submission flow already supports, ready for release day.</p>
    </div>
  </section>

  <section class="steps">
    <div class="wrap steps-grid">
      {steps.map((s) => (
        <div class="step panel">
          <div class="step-head">
            <span class="step-n">{s.n}</span>
            <svg class="step-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
          </div>
          <h2 class="step-title">{s.title}</h2>
          <p class="step-copy">{s.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap cta-row">
      <div>
        <h2 class="display cta-title">Ready when you are</h2>
        <p class="cta-copy">A manual entry path is always available if you'd rather not wait on the upload helper. Check the rules for what makes a lap count.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-red" href={`${base}time-attack/submit/`}>Submit a Lap</a>
        <a class="btn btn-outline" href={`${base}time-attack/rules/`}>Read the Rules</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem); }
  .page-title { margin: .6rem 0 .9rem; font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  .page-lede { max-width: 46ch; color: var(--gh-muted); font-size: 1.02rem; }

  .steps { padding-bottom: var(--gh-gap-section); }
  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .step { padding: var(--gh-pad-card); display: flex; flex-direction: column; gap: .9rem; }
  .step-head { display: flex; align-items: center; justify-content: space-between; }
  .step-n { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; font-size: 1.6rem; color: var(--gh-line); }
  .step-icon { color: var(--gh-yellow); flex: none; }
  .step-title { margin: 0; font-size: 1.05rem; }
  .step-copy { margin: 0; color: var(--gh-muted); font-size: .9rem; line-height: 1.5; }

  .cta-band { padding-block: var(--gh-gap-section); border-top: 1px solid var(--gh-line); background: var(--gh-surface-soft); }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .cta-title { margin: 0 0 .5rem; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .cta-copy { margin: 0; max-width: 42ch; color: var(--gh-muted); font-size: .95rem; }
  .cta-actions { display: flex; gap: .75rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .steps-grid { grid-template-columns: 1fr; }
  }
</style>
