---
// Moderator: pflege der Hub-Inhalte (Crews + Events), RS-0022.
// Schreibt direkt in `crews` / `hub_events`; RLS erlaubt Insert/Update/
// Delete nur mit Moderatorrolle (is_moderator()), die Datenbank prueft alle
// Formate (Tag 4 Zeichen, Farbe, URLs ...) zusaetzlich selbst.
import Base from '../../../layouts/Base.astro';
import ModeratorNav from '../../../components/ModeratorNav.astro';
import '../../../styles/hub.css';
import { eventTypeLabels, focusLabels, platformLabels } from '../../../data/hub';
---
<Base
  title="Hub Content — Moderator"
  description="Internal: manage crews and events shown in The Hub."
  section="moderator"
  noindex
>
  <section class="wrap mod-wrap">
    <ModeratorNav active="hub" />
    <p class="eyebrow">The Hub Operations</p>
    <h1 class="display mod-title">Hub Content</h1>
    <p class="mod-lede">Create and edit the crews and events shown in The Hub. Only entries marked <strong>Published</strong> are visible on the public site — drafts stay here.</p>

    <div id="backend-notice" class="notice" hidden>
      <strong>Backend not connected.</strong>
      <span>No Supabase project is configured for this build, so nothing can be loaded or saved here.</span>
    </div>
    <div id="auth-box" class="panel auth-box" hidden>
      <p>Sign in with Discord to access the moderator area.</p>
      <button type="button" id="discord-signin-btn" class="btn btn-outline">Sign in with Discord</button>
    </div>
    <div id="not-mod-notice" class="notice" hidden>
      <strong>Not a moderator.</strong>
      <span>Your account is signed in, but does not have moderator access.</span>
    </div>

    <div id="mod-content" hidden>
      <div class="hc-tabs" role="tablist">
        <button type="button" class="hc-tab is-active" data-kind="crews" role="tab" aria-selected="true">Crews</button>
        <button type="button" class="hc-tab" data-kind="events" role="tab" aria-selected="false">Events</button>
      </div>

      <div class="mod-layout">
        <div class="panel list-panel">
          <div class="list-head">
            <h2 class="list-title" id="list-title">Crews</h2>
            <button type="button" class="btn btn-red btn-sm" id="new-btn">+ New crew</button>
          </div>
          <div class="list" id="list"></div>
          <p class="list-empty" id="list-empty" hidden>Nothing here yet.</p>
          <p class="list-error" id="list-error" hidden></p>
        </div>

        <div class="panel editor-panel">
          <p class="editor-placeholder" id="editor-placeholder">Select an entry on the left or create a new one.</p>

          <!-- CREW FORM -->
          <form id="crew-form" class="hc-form" hidden novalidate>
            <div class="form-head">
              <h2 id="crew-form-title">New crew</h2>
              <label class="pub-toggle"><input type="checkbox" name="is_published" /> <span>Published</span></label>
            </div>
            <div class="grid">
              <label class="span2">Crew name *<input type="text" name="name" maxlength="40" required /></label>
              <label>Crew tag * <small>exactly 4 letters/digits</small><input type="text" name="tag" maxlength="4" required class="tag-input" /></label>
              <label>Crew color *<span class="color-row"><input type="color" name="color_picker" value="#ed253d" /><input type="text" name="color" value="#ed253d" maxlength="7" /></span></label>
              <label>URL slug * <small>auto from name</small><input type="text" name="slug" maxlength="48" required /></label>
              <label>Members <small>optional, e.g. from Social Club</small><input type="number" name="member_count" min="0" step="1" /></label>
              <fieldset class="span2"><legend>Platforms</legend>
                {Object.entries(platformLabels).map(([k, v]) => <label class="check"><input type="checkbox" name="platforms" value={k} /> {v}</label>)}
              </fieldset>
              <fieldset class="span2"><legend>Focus</legend>
                {Object.entries(focusLabels).map(([k, v]) => <label class="check"><input type="checkbox" name="focus" value={k} /> {v}</label>)}
              </fieldset>
              <label>Region<input type="text" name="region" maxlength="40" placeholder="e.g. Europe" /></label>
              <label>Language<input type="text" name="language" maxlength="40" placeholder="e.g. English" /></label>
              <label class="span2">Description <small><span id="crew-desc-count">0</span>/400</small><textarea name="description" maxlength="400" rows="3"></textarea></label>
              <label>Discord invite<input type="url" name="discord_url" placeholder="https://discord.gg/…" /></label>
              <label>Social Club page<input type="url" name="social_club_url" placeholder="https://socialclub.rockstargames.com/…" /></label>
              <label class="check"><input type="checkbox" name="is_partner" /> Partner crew</label>
              <label>Sort order <small>lower = earlier</small><input type="number" name="sort_order" step="1" value="0" /></label>
            </div>
            <div class="preview-wrap"><p class="preview-label">Preview</p><div class="crew-grid preview" id="crew-preview"></div></div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save</button>
              <button type="button" class="btn btn-outline-red" data-action="delete" hidden>Delete</button>
              <p class="form-msg" data-role="msg" aria-live="polite"></p>
            </div>
          </form>

          <!-- EVENT FORM -->
          <form id="event-form" class="hc-form" hidden novalidate>
            <div class="form-head">
              <h2 id="event-form-title">New event</h2>
              <label class="pub-toggle"><input type="checkbox" name="is_published" /> <span>Published</span></label>
            </div>
            <div class="grid">
              <label class="span2">Title *<input type="text" name="title" maxlength="80" required /></label>
              <label>Event type *<select name="event_type" required>{Object.entries(eventTypeLabels).map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
              <label>Status<select name="status"><option value="scheduled">Scheduled</option><option value="cancelled">Cancelled</option></select></label>
              <label>Start * <small id="tz-hint">your local time</small><input type="datetime-local" name="starts_at" required /></label>
              <label>End <small>optional</small><input type="datetime-local" name="ends_at" /></label>
              <fieldset class="span2"><legend>Platforms</legend>
                {Object.entries(platformLabels).map(([k, v]) => <label class="check"><input type="checkbox" name="platforms" value={k} /> {v}</label>)}
              </fieldset>
              <label>Host crew<select name="host_crew_id"><option value="">— none —</option></select></label>
              <label>Host name <small>if not a listed crew</small><input type="text" name="host_name" maxlength="60" /></label>
              <label>Location<input type="text" name="location" maxlength="80" placeholder="e.g. Vice Beach" /></label>
              <label>Details link<input type="url" name="join_url" placeholder="https://…" /></label>
              <label class="span2">Description <small><span id="event-desc-count">0</span>/600</small><textarea name="description" maxlength="600" rows="3"></textarea></label>
            </div>
            <div class="preview-wrap"><p class="preview-label">Preview</p><div class="ev-list preview" id="event-preview"></div></div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save</button>
              <button type="button" class="btn btn-outline-red" data-action="delete" hidden>Delete</button>
              <p class="form-msg" data-role="msg" aria-live="polite"></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .mod-wrap { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem); }
  .mod-title { margin: .4rem 0 .6rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .mod-lede { margin: 0 0 1.5rem; color: var(--gh-muted); font-size: .92rem; max-width: 46rem; }
  .notice { display: flex; flex-direction: column; gap: .3rem; margin-bottom: 1.5rem; padding: 1rem 1.2rem; border: 1px solid var(--gh-yellow); background: rgba(255,215,76,.08); border-radius: var(--gh-radius); font-size: .85rem; }
  .notice strong { color: var(--gh-yellow); }
  .auth-box { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .auth-box p { margin: 0; font-size: .88rem; }

  .hc-tabs { display: flex; gap: .4rem; margin-bottom: 1rem; }
  .hc-tab { padding: .55rem 1.1rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: transparent; color: var(--gh-muted); font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: .85rem; cursor: pointer; }
  .hc-tab.is-active { color: var(--gh-text); border-color: var(--gh-muted); background: var(--gh-surface-soft); }

  .mod-layout { display: grid; grid-template-columns: 20rem 1fr; gap: 1.5rem; align-items: start; }
  @media (max-width: 900px) { .mod-layout { grid-template-columns: 1fr; } }
  .list-panel { padding: 1.1rem; position: sticky; top: 5.5rem; }
  @media (max-width: 900px) { .list-panel { position: static; } }
  .list-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: 1rem; }
  .list-title { margin: 0; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.15rem; }
  .btn-sm { padding: .45rem .8rem; font-size: .78rem; }
  .list { display: flex; flex-direction: column; gap: .45rem; max-height: 34rem; overflow-y: auto; }
  .list-empty, .list-error { margin: 0; color: var(--gh-muted); font-size: .85rem; }
  .list-error { color: var(--gh-red); }
  /* built via innerHTML -> :global */
  :global(.li) { display: flex; align-items: center; gap: .6rem; width: 100%; text-align: left; padding: .6rem .7rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); border-left: 3px solid transparent; background: var(--gh-surface-soft); color: var(--gh-text); cursor: pointer; font-family: var(--gh-font-body); }
  :global(.li:hover) { border-color: var(--gh-muted); }
  :global(.li.is-active) { border-left-color: var(--gh-yellow); background: rgba(255,215,76,.08); }
  :global(.li-main) { flex: 1; min-width: 0; }
  :global(.li-title) { display: block; font-weight: 700; font-size: .86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.li-sub) { display: block; color: var(--gh-muted); font-size: .74rem; margin-top: .15rem; }
  :global(.li-pill) { flex: none; padding: .12rem .45rem; border-radius: 999px; font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  :global(.li-pill.pub) { background: rgba(79,209,197,.14); color: #4fd1c5; }
  :global(.li-pill.draft) { background: var(--gh-surface); color: var(--gh-muted); border: 1px solid var(--gh-line); }

  .editor-panel { padding: var(--gh-pad-card); min-height: 20rem; }
  .editor-placeholder { margin: 0; color: var(--gh-muted); font-size: .9rem; }
  .form-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--gh-line); }
  .form-head h2 { margin: 0; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.35rem; }
  .hc-form .pub-toggle { flex-direction: row; text-transform: none; letter-spacing: 0; color: var(--gh-text); }
  .pub-toggle { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .8rem; border-radius: 999px; border: 1px solid var(--gh-line); font-size: .8rem; font-weight: 700; cursor: pointer; }
  .pub-toggle input { width: 1rem; height: 1rem; accent-color: #4fd1c5; }
  .pub-toggle:has(input:checked) { border-color: #4fd1c5; color: #4fd1c5; }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 1.1rem; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
  .span2 { grid-column: 1 / -1; }
  .hc-form label, .hc-form legend { display: flex; flex-direction: column; gap: .35rem; font-size: .72rem; color: var(--gh-muted); font-weight: 700; text-transform: uppercase; letter-spacing: .03em; }
  .hc-form small { font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--gh-muted); opacity: .8; }
  .hc-form input[type="text"], .hc-form input[type="url"], .hc-form input[type="number"], .hc-form input[type="datetime-local"], .hc-form select, .hc-form textarea {
    padding: .6rem .7rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-bg); color: var(--gh-text);
    font-size: .88rem; font-family: var(--gh-font-body); text-transform: none; letter-spacing: normal; font-weight: 400; color-scheme: dark;
  }
  .hc-form select option { background: var(--gh-surface); }
  .hc-form textarea { resize: vertical; }
  .hc-form :is(input, select, textarea):focus { outline: 2px solid var(--gh-yellow); outline-offset: 1px; }
  .hc-form :is(input, select, textarea)[aria-invalid="true"] { border-color: var(--gh-red); }
  .tag-input { text-transform: uppercase !important; letter-spacing: .12em !important; font-weight: 800 !important; }
  .color-row { display: flex; gap: .5rem; }
  .color-row input[type="color"] { width: 2.6rem; height: 2.4rem; padding: 0; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); background: none; cursor: pointer; }
  .color-row input[type="text"] { flex: 1; min-width: 0; }
  fieldset { border: 1px solid var(--gh-line); border-radius: var(--gh-radius); padding: .6rem .8rem .7rem; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; }
  fieldset legend { padding: 0 .3rem; }
  .hc-form label.check { flex-direction: row; align-items: center; gap: .45rem; text-transform: none; letter-spacing: 0; font-size: .86rem; font-weight: 600; color: var(--gh-text); }
  .check input { width: 1rem; height: 1rem; accent-color: var(--gh-red); }

  .preview-wrap { margin-top: 1.5rem; padding-top: 1.1rem; border-top: 1px solid var(--gh-line); }
  .preview-label { margin: 0 0 .7rem; color: var(--gh-muted); font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .crew-grid.preview { grid-template-columns: minmax(0, 24rem); }
  .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; margin-top: 1.4rem; }
  .form-msg { margin: 0; font-size: .84rem; }
  .form-msg.is-error { color: var(--gh-red); }
  .form-msg.is-ok { color: #4fd1c5; }
</style>

<script>
  import { getSupabase, backendConfigured } from '../../../scripts/supabase-client';
  import { crewCardHtml, eventRowHtml, crewTagHtml, esc, localizeTimes, type HubCrew, type HubEvent } from '../../../data/hub';

  type Kind = 'crews' | 'events';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const authBoxEl = $('auth-box');
  const notModEl = $('not-mod-notice');
  const contentEl = $('mod-content');
  const listEl = $('list');
  const listEmptyEl = $('list-empty');
  const listErrorEl = $('list-error');
  const listTitleEl = $('list-title');
  const newBtn = $<HTMLButtonElement>('new-btn');
  const placeholderEl = $('editor-placeholder');
  const crewForm = $<HTMLFormElement>('crew-form');
  const eventForm = $<HTMLFormElement>('event-form');

  let kind: Kind = 'crews';
  let crews: any[] = [];
  let events: any[] = [];
  let selectedId: string | null = null; // null + form visible = creating new
  let ownDriverId: string | null = null;

  // ------------------------------------------------------------ helpers
  const slugify = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 48);
  const blank = (v: FormDataEntryValue | null) => { const t = String(v ?? '').trim(); return t === '' ? null : t; };
  const toLocalInput = (iso: string | null) => {
    if (!iso) return '';
    const d = new Date(iso); const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
  };
  const fromLocalInput = (v: string) => (v ? new Date(v).toISOString() : null);

  function msg(form: HTMLFormElement, text: string, isError = false) {
    const el = form.querySelector<HTMLElement>('[data-role="msg"]')!;
    el.textContent = text;
    el.className = `form-msg ${text ? (isError ? 'is-error' : 'is-ok') : ''}`;
  }
  function markInvalid(form: HTMLFormElement, names: string[]) {
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    names.forEach((n) => form.querySelector(`[name="${n}"]`)?.setAttribute('aria-invalid', 'true'));
  }
  // Friendlier wording for the database's own checks.
  function dbError(e: { message: string; code?: string }) {
    const m = e.message || '';
    if (e.code === '23505' || /duplicate key/.test(m)) return 'This URL slug is already used by another crew — change it.';
    if (/crews_tag_check/.test(m)) return 'Crew tag must be exactly 4 letters/digits.';
    if (/row-level security/.test(m)) return 'Not allowed — your account is not a moderator.';
    if (/check constraint/.test(m)) return `The database rejected a value (${m.match(/"([^"]+)"/)?.[1] ?? 'check'}). Please review the fields.`;
    return m;
  }

  // Clear a field's error mark (and the error line) as soon as it is edited.
  [crewForm, eventForm].forEach((form) => form.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t.getAttribute('aria-invalid')) {
      t.removeAttribute('aria-invalid');
      if (!form.querySelector('[aria-invalid]')) msg(form, '');
    }
  }));

  // ------------------------------------------------------------ list
  function renderList() {
    const rows = kind === 'crews' ? crews : events;
    listTitleEl.textContent = kind === 'crews' ? 'Crews' : 'Events';
    newBtn.textContent = kind === 'crews' ? '+ New crew' : '+ New event';
    listEl.innerHTML = rows.map((r) => {
      const id = kind === 'crews' ? r.crew_id : r.event_id;
      const pill = r.is_published ? '<span class="li-pill pub">Live</span>' : '<span class="li-pill draft">Draft</span>';
      if (kind === 'crews') {
        return `<button type="button" class="li${id === selectedId ? ' is-active' : ''}" data-id="${esc(id)}">${crewTagHtml(r.tag, r.color, 'sm')}<span class="li-main"><span class="li-title">${esc(r.name)}</span><span class="li-sub">/${esc(r.slug)}</span></span>${pill}</button>`;
      }
      const when = new Date(r.starts_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
      return `<button type="button" class="li${id === selectedId ? ' is-active' : ''}" data-id="${esc(id)}"><span class="li-main"><span class="li-title">${r.status === 'cancelled' ? '✕ ' : ''}${esc(r.title)}</span><span class="li-sub">${esc(when)}</span></span>${pill}</button>`;
    }).join('');
    listEmptyEl.hidden = rows.length > 0;
  }

  async function loadAll() {
    listErrorEl.hidden = true;
    const sb = getSupabase();
    const [c, e] = await Promise.all([
      sb.from('crews').select('*').order('is_partner', { ascending: false }).order('sort_order').order('name'),
      sb.from('hub_events').select('*').order('starts_at', { ascending: false }),
    ]);
    if (c.error || e.error) {
      listErrorEl.textContent = `Could not load: ${(c.error || e.error)!.message}`;
      listErrorEl.hidden = false;
    }
    crews = c.data ?? [];
    events = e.data ?? [];
    renderList();
    fillHostSelect();
  }

  function fillHostSelect() {
    const sel = eventForm.elements.namedItem('host_crew_id') as HTMLSelectElement;
    const current = sel.value;
    sel.innerHTML = '<option value="">— none —</option>' + crews.map((c) => `<option value="${esc(c.crew_id)}">${esc(c.tag)} · ${esc(c.name)}${c.is_published ? '' : ' (draft)'}</option>`).join('');
    sel.value = current;
  }

  function showForm(which: Kind | null) {
    placeholderEl.hidden = which !== null;
    crewForm.hidden = which !== 'crews';
    eventForm.hidden = which !== 'events';
  }

  // ------------------------------------------------------------ crew form
  const cf = crewForm.elements as any;
  let slugTouched = false;

  function crewFromForm(): HubCrew & { slug: string; sort_order: number; is_published: boolean } {
    const fd = new FormData(crewForm);
    const mc = blank(fd.get('member_count'));
    return {
      slug: String(fd.get('slug') ?? '').trim(),
      name: String(fd.get('name') ?? '').trim(),
      tag: String(fd.get('tag') ?? '').trim().toUpperCase(),
      color: String(fd.get('color') ?? '').trim().toLowerCase(),
      platforms: fd.getAll('platforms') as any,
      focus: fd.getAll('focus') as any,
      region: blank(fd.get('region')),
      language: blank(fd.get('language')),
      description: blank(fd.get('description')),
      member_count: mc === null ? null : Math.max(0, Math.round(Number(mc))),
      discord_url: blank(fd.get('discord_url')),
      social_club_url: blank(fd.get('social_club_url')),
      is_partner: fd.get('is_partner') === 'on',
      sort_order: Math.round(Number(fd.get('sort_order') || 0)),
      is_published: fd.get('is_published') === 'on',
    };
  }

  function validateCrew(c: ReturnType<typeof crewFromForm>): string[] {
    const bad: string[] = [];
    if (c.name.length < 2) bad.push('name');
    if (!/^[A-Z0-9]{4}$/.test(c.tag)) bad.push('tag');
    if (!/^#[0-9a-f]{6}$/.test(c.color)) bad.push('color');
    if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(c.slug)) bad.push('slug');
    if (c.discord_url && !/^https:\/\/(discord\.gg|discord\.com\/invite)\/[A-Za-z0-9-]+$/.test(c.discord_url)) bad.push('discord_url');
    if (c.social_club_url && !/^https:\/\/socialclub\.rockstargames\.com\//.test(c.social_club_url)) bad.push('social_club_url');
    return bad;
  }
  const crewFieldHelp: Record<string, string> = {
    name: 'name (2–40 characters)', tag: 'tag (exactly 4 letters/digits)', color: 'color (#rrggbb)', slug: 'URL slug (a-z, 0-9, hyphens)',
    discord_url: 'Discord invite (https://discord.gg/… or https://discord.com/invite/…)', social_club_url: 'Social Club link (https://socialclub.rockstargames.com/…)',
  };

  function renderCrewPreview() {
    const c = crewFromForm();
    const safe = { ...c, tag: c.tag || '????', name: c.name || 'Crew name', color: /^#[0-9a-f]{6}$/.test(c.color) ? c.color : '#a0a0c6' };
    $('crew-preview').innerHTML = crewCardHtml(safe);
    $('crew-desc-count').textContent = String((cf.description.value || '').length);
  }

  function openCrew(row: any | null) {
    selectedId = row?.crew_id ?? null;
    crewForm.reset();
    slugTouched = Boolean(row);
    $('crew-form-title').textContent = row ? `Edit: ${row.name}` : 'New crew';
    const r = row ?? { color: '#ed253d', platforms: [], focus: [], sort_order: 0 };
    for (const k of ['name', 'tag', 'slug', 'region', 'language', 'description', 'discord_url', 'social_club_url']) cf[k].value = r[k] ?? '';
    cf.color.value = r.color ?? '#ed253d';
    cf.color_picker.value = r.color ?? '#ed253d';
    cf.member_count.value = r.member_count ?? '';
    cf.sort_order.value = r.sort_order ?? 0;
    cf.is_partner.checked = Boolean(r.is_partner);
    cf.is_published.checked = Boolean(r.is_published);
    crewForm.querySelectorAll<HTMLInputElement>('input[name="platforms"]').forEach((i) => (i.checked = (r.platforms ?? []).includes(i.value)));
    crewForm.querySelectorAll<HTMLInputElement>('input[name="focus"]').forEach((i) => (i.checked = (r.focus ?? []).includes(i.value)));
    resetDelete(crewForm, Boolean(row));
    markInvalid(crewForm, []);
    msg(crewForm, '');
    showForm('crews');
    renderCrewPreview();
    renderList();
  }

  cf.name.addEventListener('input', () => { if (!slugTouched) cf.slug.value = slugify(cf.name.value); });
  cf.slug.addEventListener('input', () => { slugTouched = true; });
  cf.tag.addEventListener('input', () => { cf.tag.value = cf.tag.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); });
  cf.color_picker.addEventListener('input', () => { cf.color.value = cf.color_picker.value; renderCrewPreview(); });
  cf.color.addEventListener('input', () => { if (/^#[0-9a-fA-F]{6}$/.test(cf.color.value)) cf.color_picker.value = cf.color.value.toLowerCase(); });
  crewForm.addEventListener('input', renderCrewPreview);
  crewForm.addEventListener('change', renderCrewPreview);

  crewForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const c = crewFromForm();
    const bad = validateCrew(c);
    markInvalid(crewForm, bad);
    if (bad.length) { msg(crewForm, `Please fix: ${bad.map((b) => crewFieldHelp[b] ?? b).join('; ')}.`, true); return; }
    const sb = getSupabase();
    const q = selectedId
      ? sb.from('crews').update(c).eq('crew_id', selectedId).select().single()
      : sb.from('crews').insert(c).select().single();
    const { data, error } = await q;
    if (error) { msg(crewForm, dbError(error), true); return; }
    await loadAll();
    openCrew(data);
    msg(crewForm, c.is_published ? 'Saved — live on the site.' : 'Saved as draft (not visible publicly).');
  });

  // ------------------------------------------------------------ event form
  const ef = eventForm.elements as any;
  $('tz-hint').textContent = `your local time (${Intl.DateTimeFormat().resolvedOptions().timeZone})`;

  function eventFromForm() {
    const fd = new FormData(eventForm);
    return {
      title: String(fd.get('title') ?? '').trim(),
      event_type: String(fd.get('event_type')),
      status: String(fd.get('status')),
      starts_at: fromLocalInput(String(fd.get('starts_at') ?? '')),
      ends_at: fromLocalInput(String(fd.get('ends_at') ?? '')),
      platforms: fd.getAll('platforms') as string[],
      host_crew_id: blank(fd.get('host_crew_id')),
      host_name: blank(fd.get('host_name')),
      location: blank(fd.get('location')),
      description: blank(fd.get('description')),
      join_url: blank(fd.get('join_url')),
      is_published: fd.get('is_published') === 'on',
    };
  }
  function validateEvent(e: ReturnType<typeof eventFromForm>): string[] {
    const bad: string[] = [];
    if (e.title.length < 3) bad.push('title');
    if (!e.starts_at) bad.push('starts_at');
    if (e.ends_at && e.starts_at && new Date(e.ends_at) <= new Date(e.starts_at)) bad.push('ends_at');
    if (e.join_url && !/^https:\/\//.test(e.join_url)) bad.push('join_url');
    return bad;
  }
  const eventFieldHelp: Record<string, string> = { title: 'title (3–80 characters)', starts_at: 'start date/time', ends_at: 'end must be after start', join_url: 'details link must start with https://' };

  function renderEventPreview() {
    const e = eventFromForm();
    const host = crews.find((c) => c.crew_id === e.host_crew_id);
    const preview: HubEvent = {
      event_id: 'preview', title: e.title || 'Event title', event_type: e.event_type as any, starts_at: e.starts_at ?? new Date().toISOString(),
      ends_at: e.ends_at, platforms: e.platforms as any, host_name: e.host_name, location: e.location, description: e.description,
      join_url: e.join_url, status: e.status as any, host: host ? { name: host.name, tag: host.tag, color: host.color } : null,
    };
    const root = $('event-preview');
    root.innerHTML = eventRowHtml(preview);
    localizeTimes(root);
    $('event-desc-count').textContent = String((ef.description.value || '').length);
  }

  function openEvent(row: any | null) {
    selectedId = row?.event_id ?? null;
    eventForm.reset();
    $('event-form-title').textContent = row ? `Edit: ${row.title}` : 'New event';
    const r = row ?? { event_type: 'race', status: 'scheduled', platforms: [] };
    for (const k of ['title', 'host_name', 'location', 'description', 'join_url']) ef[k].value = r[k] ?? '';
    ef.event_type.value = r.event_type;
    ef.status.value = r.status;
    ef.starts_at.value = toLocalInput(r.starts_at ?? null);
    ef.ends_at.value = toLocalInput(r.ends_at ?? null);
    ef.host_crew_id.value = r.host_crew_id ?? '';
    ef.is_published.checked = Boolean(r.is_published);
    eventForm.querySelectorAll<HTMLInputElement>('input[name="platforms"]').forEach((i) => (i.checked = (r.platforms ?? []).includes(i.value)));
    resetDelete(eventForm, Boolean(row));
    markInvalid(eventForm, []);
    msg(eventForm, '');
    showForm('events');
    renderEventPreview();
    renderList();
  }
  eventForm.addEventListener('input', renderEventPreview);
  eventForm.addEventListener('change', renderEventPreview);

  eventForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const e = eventFromForm();
    const bad = validateEvent(e);
    markInvalid(eventForm, bad);
    if (bad.length) { msg(eventForm, `Please fix: ${bad.map((b) => eventFieldHelp[b] ?? b).join('; ')}.`, true); return; }
    const sb = getSupabase();
    const q = selectedId
      ? sb.from('hub_events').update(e).eq('event_id', selectedId).select().single()
      : sb.from('hub_events').insert({ ...e, created_by: ownDriverId }).select().single();
    const { data, error } = await q;
    if (error) { msg(eventForm, dbError(error), true); return; }
    await loadAll();
    openEvent(data);
    msg(eventForm, e.is_published ? 'Saved — live on the site.' : 'Saved as draft (not visible publicly).');
  });

  // ------------------------------------------------------------ delete (two-step, no browser dialog)
  function resetDelete(form: HTMLFormElement, show: boolean) {
    const b = form.querySelector<HTMLButtonElement>('[data-action="delete"]')!;
    b.hidden = !show;
    b.dataset.armed = '';
    b.textContent = 'Delete';
  }
  [crewForm, eventForm].forEach((form) => {
    const b = form.querySelector<HTMLButtonElement>('[data-action="delete"]')!;
    b.addEventListener('click', async () => {
      if (!selectedId) return;
      if (!b.dataset.armed) {
        b.dataset.armed = '1';
        b.textContent = form === crewForm ? 'Click again to delete this crew' : 'Click again to delete this event';
        setTimeout(() => { if (b.dataset.armed) { b.dataset.armed = ''; b.textContent = 'Delete'; } }, 4000);
        return;
      }
      const sb = getSupabase();
      const table = form === crewForm ? 'crews' : 'hub_events';
      const key = form === crewForm ? 'crew_id' : 'event_id';
      const { error } = await sb.from(table).delete().eq(key, selectedId);
      if (error) { msg(form, dbError(error), true); resetDelete(form, true); return; }
      selectedId = null;
      showForm(null);
      await loadAll();
      placeholderEl.textContent = 'Deleted.';
    });
  });

  // ------------------------------------------------------------ wiring
  document.querySelectorAll<HTMLButtonElement>('.hc-tab').forEach((t) => t.addEventListener('click', () => {
    document.querySelectorAll('.hc-tab').forEach((x) => { x.classList.toggle('is-active', x === t); x.setAttribute('aria-selected', String(x === t)); });
    kind = t.dataset.kind as Kind;
    selectedId = null;
    showForm(null);
    placeholderEl.textContent = 'Select an entry on the left or create a new one.';
    renderList();
  }));
  newBtn.addEventListener('click', () => (kind === 'crews' ? openCrew(null) : openEvent(null)));
  listEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.li');
    if (!btn) return;
    const id = btn.dataset.id;
    if (kind === 'crews') openCrew(crews.find((c) => c.crew_id === id));
    else openEvent(events.find((x) => x.event_id === id));
  });

  // ------------------------------------------------------------ auth (same pattern as /moderator/)
  async function checkModerator(session: any) {
    if (!session) { authBoxEl.hidden = false; notModEl.hidden = true; contentEl.hidden = true; return; }
    authBoxEl.hidden = true;
    const sb = getSupabase();
    const { data, error } = await sb.from('moderators').select('driver_id').limit(1);
    const isMod = !error && Array.isArray(data) && data.length > 0;
    notModEl.hidden = isMod;
    contentEl.hidden = !isMod;
    if (!isMod) return;
    const own = await sb.from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    ownDriverId = own.data?.driver_id ?? null;
    await loadAll();
  }

  if (!backendConfigured) {
    $('backend-notice').hidden = false;
  } else {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => checkModerator(data?.session ?? null));
    sb.auth.onAuthStateChange((event, session) => { if (event === 'SIGNED_IN' || event === 'SIGNED_OUT') checkModerator(session); });
    $('discord-signin-btn').addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname + window.location.search, scopes: 'identify email guilds.join' } });
    });
  }
</script>
