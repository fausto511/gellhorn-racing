---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
import '../styles/hub.css';
import { sampleCrews, sampleEventsUpcoming } from '../data/hub';
import { homeCrewCard, homeEventCard } from '../data/home';
const base = import.meta.env.BASE_URL;
const home = new URL(base, Astro.site).href;
const crewsHtml = sampleCrews.slice(0, 4).map(homeCrewCard).join('');
const eventsHtml = sampleEventsUpcoming().filter((e) => e.status !== 'cancelled').slice(0, 4).map(homeEventCard).join('');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: home,
    inLanguage: 'en',
    description: 'GTA VI racing database and community: vehicles with verified classes, proof-based lap-time leaderboards, and a hub for racing events and crews.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: home,
    sameAs: ['https://discord.gg/hPGuBwXRqT'],
  },
];
---
<Base
  title="Leonida Racing — GTA 6 Racing Database & Community"
  description="Leonida Racing is a GTA VI racing database and community: vehicles with verified classes, proof-based lap-time leaderboards starting at Gellhorn International Raceway, and racing events and crews."
  jsonLd={jsonLd}
>
  <!-- Home layout (Fausto, 2026-09-28): full-width hero image over roughly
       the top two thirds, thin white line, then the normal background with
       Crews and Events strips. Hero image: Visual/Cars/gellhorn-race.png
       (car-maker badge removed for the web version). -->
  <section class="home-hero">
    <picture class="home-hero-bg">
      <source type="image/webp" srcset={`${base}images/home/home-hero-640.webp 640w, ${base}images/home/home-hero-1080.webp 1080w, ${base}images/home/home-hero-1562.webp 1562w`} sizes="100vw" />
      <img src={`${base}images/home/home-hero-1562.jpg`} alt="" width="1562" height="1007" loading="eager" fetchpriority="high" />
    </picture>
    <div class="home-hero-veil" aria-hidden="true"></div>

    <div class="wrap home-hero-inner">
      <div class="home-intro">
        <p class="eyebrow">GTA VI Racing Database &amp; Community</p>
        <h1 class="display home-title">Every car, every lap,<br />every crew in Leonida.</h1>
        <p class="home-lede">Look up every confirmed car, set proof-backed lap times at Gellhorn International Raceway, and find the crews and race nights of the GTA VI scene. Independent, free, and built with the community — ready for launch day.</p>
        <div class="home-cta">
          <button type="button" id="home-join" class="btn home-join">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 5.3A18 18 0 0 0 15.9 4l-.3.6a15 15 0 0 1 4 1.6 16 16 0 0 0-13.2 0 15 15 0 0 1 4-1.6L10.1 4a18 18 0 0 0-4.4 1.3C2.9 9 2.2 12.6 2.5 16.1a18 18 0 0 0 5.5 2.8l.8-1.3a11 11 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 9.2 0l.5.4a11 11 0 0 1-1.9.9l.8 1.3a18 18 0 0 0 5.5-2.8c.4-4-.7-7.5-2.2-10.8ZM9.3 14c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Zm5.4 0c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Z"/></svg>
            <span>Login with Discord</span>
          </button>
          <a id="home-account" class="btn btn-white-tonal home-join" href={`${base}account/`} hidden>Go to My Account</a>
        </div>
      </div>

      <div class="home-tiles">
        <a class="home-tile" href={`${base}garage/`}>
          <img src={`${base}images/garage/garage-hero-placeholder.webp`} alt="" width="1672" height="941" loading="eager" />
          <span class="home-tile-veil" aria-hidden="true"></span>
          <span class="home-tile-copy">
            <span class="eyebrow">Vehicles</span>
            <span class="display home-tile-title">The Garage</span>
            <span class="home-tile-lede">Classes and stats for every confirmed car</span>
          </span>
        </a>
        <a class="home-tile" href={`${base}time-attack/gellhorn-international-raceway/`}>
          <picture>
            <source type="image/webp" srcset={`${base}images/gellhorn-raceway-640.webp 640w, ${base}images/gellhorn-raceway-1080.webp 1080w`} sizes="(max-width: 760px) 80vw, 33vw" />
            <img src={`${base}images/gellhorn-raceway-1672.jpg`} alt="" width="1672" height="941" loading="eager" />
          </picture>
          <span class="home-tile-veil" aria-hidden="true"></span>
          <span class="home-tile-copy">
            <span class="eyebrow">Time Attack</span>
            <span class="display home-tile-title">The Track</span>
            <span class="home-tile-lede">Submit a lap, climb the leaderboard</span>
          </span>
        </a>
        <a class="home-tile" href={`${base}hub/`}>
          <picture>
            <source type="image/webp" srcset={`${base}images/hub/hub-carmeet-640.webp 640w, ${base}images/hub/hub-carmeet-1080.webp 1080w`} sizes="(max-width: 760px) 80vw, 33vw" />
            <img src={`${base}images/hub/hub-carmeet-1672.jpg`} alt="" width="1672" height="940" loading="eager" />
          </picture>
          <span class="home-tile-veil" aria-hidden="true"></span>
          <span class="home-tile-copy">
            <span class="eyebrow">Community</span>
            <span class="display home-tile-title">The Hub</span>
            <span class="home-tile-lede">Race nights, car meets and crews</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="wrap home-strip">
    <div class="home-strip-head">
      <h2 class="display home-strip-title">Crews</h2>
      <span class="hub-sample-flag" id="home-crew-flag">Sample data</span>
      <a class="home-strip-link" href={`${base}hub/crews/`}>All crews →</a>
    </div>
    <p class="home-strip-lede">Racing crews, leagues and car meet communities on PS5 — find one that races the way you do.</p>
    <div class="home-row" id="home-crews" set:html={crewsHtml} />
  </section>

  <section class="wrap home-strip">
    <div class="home-strip-head">
      <h2 class="display home-strip-title">Events</h2>
      <span class="hub-sample-flag" id="home-ev-flag">Sample data</span>
      <a class="home-strip-link" href={`${base}hub/events/`}>All events →</a>
    </div>
    <p class="home-strip-lede">Race nights, league rounds and car meets from the community — shown in your local time.</p>
    <div class="home-row" id="home-events" set:html={eventsHtml} />
  </section>
</Base>

<style>
  [hidden] { display: none !important; }

  /* ---- Hero: image over ~2/3 of the viewport, thin white line below ---- */
  .home-hero {
    position: relative;
    min-height: calc(66vh - var(--gh-header-h));
    min-height: calc(66svh - var(--gh-header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 1px solid var(--gh-line); /* same hairline as under the header */
  }
  .home-hero-bg, .home-hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .home-hero-veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 55% at 50% 38%, rgba(20,20,26,.72) 0%, rgba(20,20,26,.35) 70%, rgba(20,20,26,.2) 100%),
      linear-gradient(0deg, rgba(20,20,26,.92) 0%, rgba(20,20,26,.35) 45%, rgba(20,20,26,.35) 100%);
  }
  .home-hero-inner { position: relative; width: 100%; padding-block: clamp(2rem, 4.5vw, 3.25rem) clamp(1.5rem, 3vw, 2rem); display: grid; gap: clamp(1.75rem, 4vw, 2.75rem); }
  .home-intro { max-width: 46rem; margin-inline: auto; text-align: center; }
  .home-title { margin: .5rem 0 1rem; font-size: clamp(2.2rem, 5.2vw, 4rem); line-height: .98; }
  .home-lede { margin: 0 auto 1.6rem; color: #d9d8e8; font-size: clamp(.95rem, 1.4vw, 1.08rem); line-height: 1.6; max-width: 38rem; }
  .home-cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .6rem 1rem; }
  /* Discord's own colour for the sign-in button, as in the header. */
  .home-join { gap: .6rem; padding: .95rem 1.5rem; font-size: 1rem; }
  #home-join { background: #5865f2; color: #fff; border: none; cursor: pointer; }
  #home-join:hover { filter: brightness(1.1); }

  .home-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .home-tile {
    position: relative; display: flex; align-items: flex-end; aspect-ratio: 2 / 1; overflow: hidden;
    border-radius: var(--gh-radius-lg); border: 1px solid rgba(252,250,247,.18); text-decoration: none; color: var(--gh-text);
    background: var(--gh-surface); transition: border-color .15s, transform .15s;
  }
  .home-tile:hover, .home-tile:focus-visible { border-color: rgba(252,250,247,.55); transform: translateY(-2px); }
  .home-tile picture, .home-tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .home-tile-veil { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(20,20,26,.95) 5%, rgba(20,20,26,.45) 60%, rgba(20,20,26,.25)); transition: background .15s; }
  .home-tile:hover .home-tile-veil { background: linear-gradient(0deg, rgba(20,20,26,.9) 5%, rgba(20,20,26,.25) 60%, rgba(20,20,26,.1)); }
  .home-tile-copy { position: relative; display: flex; flex-direction: column; gap: .25rem; padding: 1rem 1.1rem; }
  .home-tile-title { font-size: clamp(1.4rem, 2.2vw, 1.8rem); }
  .home-tile-lede { color: var(--gh-muted); font-size: .82rem; }

  /* ---- Strips below the line ---- */
  .home-strip { padding-top: clamp(2.25rem, 5vw, 3.25rem); }
  .home-strip + .home-strip { padding-top: clamp(1.75rem, 4vw, 2.5rem); }
  .home-strip-head { display: flex; align-items: center; gap: .75rem; margin-bottom: .35rem; }
  .home-strip-lede { margin: 0 0 1rem; color: var(--gh-muted); font-size: .9rem; }
  .home-strip-title { margin: 0; font-size: 1.5rem; }
  .home-strip-link { margin-left: auto; color: var(--gh-muted); font-size: .85rem; font-weight: 700; text-decoration: none; }
  .home-strip-link:hover { color: var(--gh-text); }
  .home-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }

  :global(.hc-card) { display: flex; flex-direction: column; gap: .65rem; padding: 1rem; background: var(--gh-surface); border: 1px solid var(--gh-line); border-radius: var(--gh-radius-lg); text-decoration: none; color: var(--gh-text); transition: border-color .15s; min-width: 0; }
  :global(.hc-card:hover) { border-color: var(--gh-muted); }
  :global(.hc-top) { display: flex; align-items: center; gap: .7rem; min-width: 0; }
  :global(.hc-top .crew-emblem) { width: 2.6rem; height: 2.6rem; flex: none; }
  :global(.hc-name) { display: block; margin: 0; font-weight: 800; font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.hc-sub) { display: block; margin: .1rem 0 0; color: var(--gh-muted); font-size: .76rem; }
  :global(.hc-chips) { display: flex; flex-wrap: wrap; gap: .3rem; }
  :global(.he-date) { display: flex; align-items: baseline; gap: .45rem; color: var(--gh-muted); font-size: .76rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  :global(.he-day) { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; font-size: 1.6rem; color: var(--gh-text); letter-spacing: 0; }
  :global(.he-title) { display: block; margin: 0; font-weight: 800; font-size: .95rem; line-height: 1.3; }
  :global(.he-meta) { display: block; margin: 0; color: var(--gh-muted); font-size: .78rem; }

  @media (max-width: 1000px) {
    .home-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .home-hero { min-height: 0; }
    .home-hero-veil { background: linear-gradient(0deg, rgba(20,20,26,.96) 0%, rgba(20,20,26,.7) 55%, rgba(20,20,26,.45) 100%); }
    .home-join { width: 100%; }
    .home-title { font-size: clamp(1.7rem, 7.6vw, 2.2rem); }
    /* tiles and strips scroll sideways on phones instead of stacking */
    .home-tiles, .home-row { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--wrap-pad, 1.25rem); gap: .75rem; margin-inline: calc(-1 * var(--wrap-pad, 1.25rem)); padding-inline: var(--wrap-pad, 1.25rem); scrollbar-width: none; }
    .home-tiles::-webkit-scrollbar, .home-row::-webkit-scrollbar { display: none; }
    .home-tile, :global(.home-row > .hc-card) { flex: 0 0 78%; scroll-snap-align: start; }
    .home-tile { aspect-ratio: 16 / 9; }
  }
</style>

<script>
  import { backendConfigured, getSupabase } from '../scripts/supabase-client';
  import { fetchLiveCrews, fetchLiveEvents } from '../scripts/hub-live';
  import { homeCrewCard, homeEventCard } from '../data/home';
  import { localizeTimes } from '../data/hub';

  localizeTimes(document.getElementById('home-events')!);

  const join = document.getElementById('home-join') as HTMLButtonElement;
  const account = document.getElementById('home-account')!;

  if (backendConfigured) {
    const sb = getSupabase();
    const show = (signedIn: boolean) => { join.hidden = signedIn; account.hidden = !signedIn; };
    sb.auth.getSession().then(({ data }) => show(Boolean(data?.session)));
    sb.auth.onAuthStateChange((_e, s) => show(Boolean(s)));
    join.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  } else {
    join.addEventListener('click', () => { window.open('https://discord.gg/hPGuBwXRqT', '_blank', 'noopener'); });
  }

  fetchLiveCrews().then((live) => {
    if (!live || !live.length) return;
    document.getElementById('home-crews')!.innerHTML = live.slice(0, 4).map(homeCrewCard).join('');
    document.getElementById('home-crew-flag')!.hidden = true;
  });
  fetchLiveEvents().then((live) => {
    const next = (live ?? []).filter((e) => e.status !== 'cancelled' && new Date(e.starts_at).getTime() > Date.now() - 3 * 3600e3).slice(0, 4);
    if (!next.length) return;
    const root = document.getElementById('home-events')!;
    root.innerHTML = next.map(homeEventCard).join('');
    localizeTimes(root);
    document.getElementById('home-ev-flag')!.hidden = true;
  });
</script>
