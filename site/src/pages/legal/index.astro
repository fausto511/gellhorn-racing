<style>
  .page-head { padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem); }
  .page-title { margin: .6rem 0 0; font-size: clamp(2.2rem, 4.5vw, 3.2rem); }

  .prose { padding-bottom: var(--gh-gap-section); }
  .prose-body { max-width: 62ch; }
  .prose-body h2 { font-size: 1.05rem; margin: 2rem 0 .6rem; }
  .prose-body h2:first-child { margin-top: 0; }
  .prose-body p { margin: 0 0 1rem; color: var(--gh-muted); font-size: .94rem; line-height: 1.7; }
  .prose-body a { color: var(--gh-yellow); }
</style>
