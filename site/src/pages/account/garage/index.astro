---
// My Account > Garage (RS-0032, DEC-0074): every vehicle the driver owns.
// Vehicles are marked with "I own this vehicle" on their Garage page or added
// here. Private: only the driver sees this list.
import Base from '../../../layouts/Base.astro';
import AccountSubnav from '../../../components/AccountSubnav.astro';
import { vehicleOptions } from '../../../data/vehicles';
const base = import.meta.env.BASE_URL;
// grouped by class for the "add" picker (native select = low-friction on phones)
const byClass = new Map<string, typeof vehicleOptions>();
[...vehicleOptions]
  .sort((a, b) => `${a.make} ${a.model}`.localeCompare(`${b.make} ${b.model}`))
  .forEach((v) => { const c = v.classes[0] ?? 'Other'; byClass.set(c, [...(byClass.get(c) ?? []), v]); });
const groups = [...byClass.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const vehicleIndex = vehicleOptions.map((v) => ({ id: v.id, make: v.make, model: v.model, cls: v.classes.join(' / '), logo: v.logoSlug }));
---
<Base
  title="My Garage — My Account"
  description="The GTA VI vehicles you own."
  section="account"
  noindex
>
  <section class="wrap account-wrap">
    <p class="eyebrow">Private Driver Area</p>
    <h1 class="display account-title">My Account</h1>
    <AccountSubnav active="garage" />

    <div id="acc-auth" class="panel acc-auth" hidden>
      <p>Sign in with Discord to see your garage.</p>
      <button type="button" id="acc-signin" class="btn btn-outline">Sign in with Discord</button>
    </div>

    <div id="acc-body" hidden>
      <div class="mg-head">
        <div>
          <h2 class="section-heading">My Garage <span class="mg-count" id="mg-count"></span></h2>
          <p class="section-lede">Vehicles you own in GTA VI. Only you can see this list. Mark a vehicle with “I own this vehicle” on its <a href={`${base}garage/`}>Garage</a> page, or add it here.</p>
        </div>
        <label class="mg-add">
          <span class="sr-only">Add a vehicle you own</span>
          <select class="ui-select" id="mg-add">
            <option value="">+ Add a vehicle you own</option>
            {groups.map(([cls, list]) => (
              <optgroup label={cls}>{list.map((v) => <option value={v.id}>{v.make} {v.model}</option>)}</optgroup>
            ))}
          </select>
        </label>
      </div>
      <p class="mg-msg" id="mg-msg" hidden></p>
      <label class="ui-search mg-search" id="mg-search-wrap" hidden>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" id="mg-search" placeholder="Search my vehicles" aria-label="Search my vehicles" autocomplete="off" />
      </label>
      <div class="mg-grid" id="mg-grid"></div>
      <div class="panel mg-empty" id="mg-empty" hidden>
        <p><strong>Your garage is empty.</strong> Open any vehicle in <a href={`${base}garage/`}>The Garage</a> and tick “I own this vehicle” — or pick one from the list above.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .account-title { margin: .4rem 0 1.2rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .acc-auth { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .acc-auth p { margin: 0; font-size: .88rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mg-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 1.2rem; }
  .section-heading { margin: 0 0 .3rem; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  .mg-count { color: var(--gh-muted); font-size: .95rem; }
  .section-lede { margin: 0; color: var(--gh-muted); font-size: .88rem; max-width: 40rem; }
  .section-lede a, .mg-empty a { color: var(--gh-text); }
  .mg-add { flex: 0 1 20rem; display: flex; }
  .mg-add select { width: 100%; }
  .mg-msg { margin: 0 0 1rem; font-size: .82rem; color: var(--gh-muted); }
  .mg-msg.is-error { color: var(--gh-red); }
  .mg-search { max-width: 22rem; margin-bottom: 1rem; }
  .mg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .75rem; }
  .mg-empty { padding: 1.1rem 1.2rem; }
  .mg-empty p { margin: 0; font-size: .88rem; color: var(--gh-muted); }
  .mg-empty strong { color: var(--gh-text); }
  :global(.mg-card) { display: flex; flex-direction: column; gap: .7rem; padding: .9rem 1rem; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); background: var(--gh-surface); }
  :global(.mg-id) { display: flex; align-items: center; gap: .65rem; }
  :global(.mg-logo) { flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--gh-text); padding: 5px; display: inline-flex; }
  :global(.mg-logo img) { width: 100%; height: 100%; object-fit: contain; }
  :global(.mg-name) { display: flex; flex-direction: column; min-width: 0; }
  :global(.mg-name a) { color: var(--gh-text); font-weight: 700; text-decoration: none; }
  :global(.mg-name a:hover) { text-decoration: underline; text-underline-offset: 3px; }
  :global(.mg-name span) { color: var(--gh-muted); font-size: .74rem; text-transform: uppercase; letter-spacing: .03em; }
  :global(.mg-actions) { display: flex; flex-wrap: wrap; gap: .4rem; }
  :global(.mg-actions a), :global(.mg-actions button) { padding: .35rem .7rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: transparent; color: var(--gh-text); font: inherit; font-size: .76rem; font-weight: 700; text-decoration: none; cursor: pointer; }
  :global(.mg-actions a:hover), :global(.mg-actions button:hover) { border-color: var(--gh-muted); }
  :global(.mg-actions .mg-remove) { color: var(--gh-muted); margin-left: auto; }
</style>

<script define:vars={{ vehicleIndex }}>
  window.__mgVehicles = vehicleIndex;
</script>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { currentDriverId, fetchOwned, setOwned } from '../../../scripts/owned';
  import { esc } from '../../../data/hub';

  type V = { id: string; make: string; model: string; cls: string; logo: string };
  const all = (window as any).__mgVehicles as V[];
  const byId = new Map(all.map((v) => [v.id, v]));
  const base = import.meta.env.BASE_URL;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const grid = $('mg-grid');
  const addSel = $<HTMLSelectElement>('mg-add');
  const search = $<HTMLInputElement>('mg-search');
  let me: string | null = null;
  let owned = new Set<string>();

  function msg(text: string, error = false) {
    const el = $('mg-msg');
    el.textContent = text; el.hidden = !text; el.className = `mg-msg${error ? ' is-error' : ''}`;
  }

  function render() {
    const q = search.value.trim().toLowerCase();
    const list = [...owned].map((id) => byId.get(id)).filter(Boolean) as V[];
    list.sort((a, b) => `${a.make} ${a.model}`.localeCompare(`${b.make} ${b.model}`));
    const shown = list.filter((v) => !q || `${v.make} ${v.model} ${v.cls}`.toLowerCase().includes(q));
    $('mg-count').textContent = list.length ? `· ${list.length} vehicle${list.length === 1 ? '' : 's'}` : '';
    $('mg-empty').hidden = list.length > 0;
    $('mg-search-wrap').hidden = list.length < 9;
    grid.innerHTML = shown.map((v) => `
      <article class="mg-card">
        <div class="mg-id">
          <span class="mg-logo"><img src="${base}images/logos/${esc(v.logo)}-gta-6-logo.webp" alt="${esc(v.make)} logo" width="26" height="26" loading="lazy" /></span>
          <span class="mg-name"><a href="${base}garage/vehicles/${esc(v.id)}/">${esc(v.make)} ${esc(v.model)}</a><span>${esc(v.cls)}</span></span>
        </div>
        <div class="mg-actions">
          <a href="${base}time-attack/gellhorn-international-raceway/?vehicle=${encodeURIComponent(v.id)}">Gellhorn leaderboard</a>
          <button type="button" class="mg-remove" data-remove="${esc(v.id)}" aria-label="Remove ${esc(v.make)} ${esc(v.model)} from my garage">Remove</button>
        </div>
      </article>`).join('') || (list.length ? '<p class="mg-msg">No owned vehicle matches your search.</p>' : '');
    // already-owned vehicles cannot be added twice
    addSel.querySelectorAll('option[value]').forEach((o) => { const opt = o as HTMLOptionElement; if (opt.value) opt.disabled = owned.has(opt.value); });
  }

  addSel.addEventListener('change', async () => {
    const id = addSel.value;
    addSel.value = '';
    if (!id || !me || owned.has(id)) return;
    try { await setOwned(me, id, true); owned.add(id); msg(`${byId.get(id)?.make} ${byId.get(id)?.model} added.`); }
    catch { msg('Could not add the vehicle — please try again.', true); }
    render();
  });
  grid.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
    if (!b || !me) return;
    const id = b.dataset.remove!;
    b.disabled = true;
    try { await setOwned(me, id, false); owned.delete(id); msg(`${byId.get(id)?.make} ${byId.get(id)?.model} removed.`); }
    catch { b.disabled = false; msg('Could not remove the vehicle — please try again.', true); return; }
    render();
  });
  search.addEventListener('input', render);

  async function init(session: any) {
    $('acc-auth').hidden = Boolean(session);
    $('acc-body').hidden = !session;
    if (!session) return;
    me = await currentDriverId();
    if (!me) { msg('Your driver profile is not ready yet — reload the page in a moment.', true); return; }
    owned = await fetchOwned();
    render();
  }

  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    $('acc-signin').addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
