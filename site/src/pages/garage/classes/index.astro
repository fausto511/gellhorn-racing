---
import TaxonomyIndex from '../../../components/TaxonomyIndex.astro';
import { classPages, vehiclesInClass } from '../../../data/garage-taxonomy';
// Intro + description: Claude placeholders (draft-claude), Codex copy pending.
---
<TaxonomyIndex
  kind="class"
  pages={classPages.map((page) => ({ page, vehicles: vehiclesInClass(page.slug) }))}
  title="GTA VI Vehicle Classes — Browse by Class"
  heading="GTA VI Vehicle Classes"
  description="Browse GTA 6 vehicles by class: Super, Sports, Muscle, Sports Classics, Coupes, Sedans, SUVs, and Off-Road. Compare models in The Garage."
  intro="Every vehicle in The Garage belongs to at least one GTA VI class. Pick a class to see its cars, compare them, and find your next one."
/>
