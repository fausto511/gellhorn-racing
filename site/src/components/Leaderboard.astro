---
import { sampleLaps, vehiclesNeeded, leaderboardStats, makeLogo } from '../data/leaderboard';
import { vehicleOptions } from '../data/vehicles';
const base = import.meta.env.BASE_URL;
// Vehicle names link to their Garage page (2026-09-26). Live rows carry the
// vehicle_id (identical to the Garage slug); sample rows only have make +
// model, so they are matched by name -- sample vehicles that are not in the
// Garage stay plain text instead of pointing at a missing page.
const norm = (t: string) => t.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
const garageId = (make: string, model: string) =>
  vehicleOptions.find((v) => norm(v.make) === norm(make) && norm(v.model) === norm(model))?.id ?? null;
const garageHref = (make: string, model: string) => {
  const id = garageId(make, model);
  return id ? `${base}garage/vehicles/${id}/` : null;
};
---
<section id="leaderboard" class="lb">
  <div class="wrap">
    <div class="lb-head">
      <div>
        <span class="sample-flag" id="lb-flag">Sample data — no real community records yet</span>
        <h2 class="display lb-title">Leaderboard</h2>
        <p class="lb-meta" id="lb-meta">Gellhorn International Raceway · PS5 · Current Standard · {leaderboardStats.drivers} drivers · {leaderboardStats.acceptedLaps} accepted laps</p>
      </div>
      <div class="lb-tabs" role="tablist" aria-label="Leaderboard view">
        <button type="button" class="lb-tab is-active" role="tab" aria-selected="true">Overall</button>
        <button type="button" class="lb-tab" role="tab" aria-selected="false">Vehicle Records</button>
      </div>
    </div>

    <div class="lb-controls">
      <label class="ui-search lb-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" placeholder="Search driver" aria-label="Search driver" />
      </label>
      <label class="ui-search lb-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" placeholder="Search vehicle" aria-label="Search vehicle" />
      </label>
      <div class="lb-toggle" role="group" aria-label="Time filter">
        <button type="button" class="is-active">All Times</button>
        <button type="button">Verified Only</button>
      </div>
    </div>

    <div class="panel lb-table-wrap">
      <table class="lb-table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Driver</th>
            <th scope="col">Vehicle</th>
            <th scope="col">Track Entries</th>
            <th scope="col">Lap Time</th>
            <th scope="col">Status</th>
            <th scope="col">Video</th>
          </tr>
        </thead>
        <tbody id="lb-tbody">
          {sampleLaps.map((row) => (
            <tr class:list={{ 'is-top3': row.rank <= 3 }}>
              <td class="lb-rank">{row.rank}</td>
              <td class="lb-driver">{row.driver}</td>
              <td>
                {garageHref(row.make, row.model) ? (
                  <a class="lb-vehicle lb-vehicle-link" href={garageHref(row.make, row.model)} title={`${row.make} ${row.model} in The Garage`}>
                    {makeLogo(row.make) && <span class="logo-chip"><img src={makeLogo(row.make)} alt={`${row.make} logo`} width="20" height="20" loading="lazy" /></span>}
                    <span class="lb-vehicle-name"><span class="lb-make">{row.make}</span> {row.model}</span>
                  </a>
                ) : (
                  <span class="lb-vehicle">
                    {makeLogo(row.make) && <span class="logo-chip"><img src={makeLogo(row.make)} alt={`${row.make} logo`} width="20" height="20" loading="lazy" /></span>}
                    <span class="lb-make">{row.make}</span> {row.model}
                  </span>
                )}
              </td>
              <td class="lb-num">{row.entries}</td>
              <td class="lb-time">
                {row.time}
                {row.gapMs !== null && <span class="lb-gap">+{(row.gapMs / 1000).toFixed(3)}</span>}
              </td>
              <td>
                {row.videoVerified
                  ? <span class="status-ok"><span class="check-circle"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span> Video verified</span>
                  : <span class="status-pending"><span class="status-dot" /> Not video verified</span>}
              </td>
              <td class="lb-video">{row.videoVerified ? <a class="watch-btn outline-hover" href="#" aria-label={`Watch ${row.driver}'s lap`}>Watch</a> : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="panel needed">
      <div class="needed-head">
        <div class="needed-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <h3>Vehicles Needed</h3>
        </div>
        <p>These vehicles don't have a verified record yet on Gellhorn. Be the first.</p>
      </div>
      <ul>
        {vehiclesNeeded.map((v) => (
          <li>
            {makeLogo(v.make) && <span class="logo-chip logo-chip-lg"><img src={makeLogo(v.make)} alt={`${v.make} logo`} width="30" height="30" loading="lazy" /></span>}
            <span class="needed-text">
              {garageHref(v.make, v.model)
                ? <a class="needed-link" href={garageHref(v.make, v.model)}><strong>{v.make} {v.model}</strong></a>
                : <strong>{v.make} {v.model}</strong>}
              <span>No verified record</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .lb { padding-top: 1rem; padding-bottom: var(--gh-gap-section); }
  .lb-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: 1.5rem; }
  .sample-flag { display: inline-block; margin-bottom: .7rem; padding: .3rem .65rem; border-radius: 999px; background: rgba(237,37,61,.14); color: var(--gh-red); font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  /* JS sets [hidden] on this once live data loads; without this rule the
     UA default [hidden]{display:none} loses to the display:inline-block
     above (author CSS always beats UA CSS), so the badge stayed visible
     even though renderLiveRows() correctly hid it. */
  .sample-flag[hidden] { display: none; }
  .lb-title { font-size: clamp(1.9rem, 3vw, 2.6rem); margin: 0; }
  .lb-meta { margin: .5rem 0 0; color: var(--gh-muted); font-size: .85rem; }
  .lb-tabs { display: flex; gap: .5rem; }
  .lb-tab { padding: .55rem 1.1rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: transparent; color: var(--gh-muted); font-weight: 700; font-size: .82rem; cursor: pointer; }
  .lb-tab.is-active { border-color: var(--gh-yellow); color: var(--gh-yellow); }

  .lb-controls { display: flex; flex-wrap: wrap; gap: .85rem; margin-bottom: 1.25rem; }
  .lb-search { flex: 1 1 14rem; } /* look: site-wide .ui-search (tokens.css) */
  .lb-toggle { display: inline-flex; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); overflow: hidden; }
  .lb-toggle button { padding: .65rem 1.1rem; border: none; background: transparent; color: var(--gh-muted); font-weight: 700; font-size: .78rem; cursor: pointer; }
  .lb-toggle button.is-active { background: var(--gh-yellow); color: #1a1206; }

  .lb-table-wrap { padding: 0; overflow-x: auto; }
  .lb-table { width: 100%; border-collapse: collapse; min-width: 46rem; }
  .lb-table th { text-align: left; padding: .9rem 1.1rem; color: var(--gh-muted); font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border-bottom: 1px solid var(--gh-line); }
  /* :global() throughout this block: #lb-tbody's real rows are inserted at
     runtime via innerHTML from live Supabase data (renderLiveRows() below),
     so Astro's scoped-CSS attribute never reaches them -- same bug class
     already found and fixed on the account page's .records-table (see
     e8ce020). Without :global() every one of these rules silently only
     ever applied to the build-time sample rows, and live rows fell back to
     bare browser defaults: ~1px cell padding, no rank/gap/logo/status
     styling, no top3 highlight -- which is exactly what "sieht komisch
     aus" / "Tabelle sieht nicht ordentlich aus" was. */
  :global(.lb-table td) { padding: .85rem 1.1rem; font-size: .88rem; border-bottom: 1px solid var(--gh-line); }
  :global(.lb-table tbody tr:last-child td) { border-bottom: none; }
  :global(.lb-table tr.is-top3) { background: rgba(255,215,76,.05); }
  :global(.lb-rank) { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; color: var(--gh-muted); }
  :global(.is-top3 .lb-rank) { color: var(--gh-yellow); }
  :global(.lb-driver) { font-weight: 700; }
  :global(.lb-crew-tag) { margin-left: .45rem; vertical-align: 1px; }
  :global(.lb-vehicle) { display: inline-flex; align-items: center; gap: .5rem; }
  :global(.lb-vehicle-link) { color: inherit; text-decoration: none; }
  /* same spacing between make and model as the non-link rows (flex gap) */
  :global(.lb-vehicle-name) { display: inline-flex; align-items: baseline; gap: .5rem; }
  :global(.lb-vehicle-link:hover .lb-vehicle-name), :global(.lb-vehicle-link:focus-visible .lb-vehicle-name) { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--gh-muted); }
  .needed-link { color: inherit; text-decoration: none; }
  .needed-link:hover strong { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--gh-muted); }
  :global(.lb-make) { color: var(--gh-muted); font-size: .78rem; }
  :global(.lb-num) { color: var(--gh-muted); }
  :global(.lb-time) { font-variant-numeric: tabular-nums; font-weight: 700; }
  :global(.lb-gap) { display: block; color: var(--gh-muted); font-size: .72rem; font-weight: 400; }
  :global(.status-ok) { color: var(--gh-yellow); }
  :global(.check-circle) { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; flex: none; border-radius: 50%; background: var(--gh-yellow); color: #1a1206; }
  :global(.watch-btn) { display: inline-flex; align-items: center; padding: .35rem .8rem; border-radius: var(--gh-radius); background: transparent; border: 1px solid var(--gh-line); color: var(--gh-text); font-size: .76rem; font-weight: 700; text-decoration: none; }

  :global(.logo-chip) { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex: none; border-radius: 50%; background: var(--gh-text); padding: 4px; }
  :global(.logo-chip img) { width: 100%; height: 100%; object-fit: contain; display: block; }
  .logo-chip-lg { width: 40px; height: 40px; padding: 5px; }

  .needed { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; margin-top: 1.25rem; padding: var(--gh-pad-card); }
  .needed-title { display: flex; align-items: center; gap: .5rem; }
  .needed-title svg { color: var(--gh-yellow); flex: none; }
  .needed-head h3 { margin: 0; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  .needed-head p { margin: .3rem 0 0; max-width: 30ch; color: var(--gh-muted); font-size: .82rem; }
  .needed ul { display: flex; flex-wrap: wrap; gap: .75rem; list-style: none; margin: 0; padding: 0; flex: 1; justify-content: flex-end; }
  .needed li { display: flex; align-items: center; gap: .6rem; padding: .7rem .95rem; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); min-width: 13rem; }
  .needed-text { display: flex; flex-direction: column; gap: .2rem; }
  .needed-text strong { font-size: .82rem; }
  .needed-text span { color: var(--gh-muted); font-size: .7rem; }

  @media (max-width: 700px) {
    .lb-head { align-items: flex-start; }
    .needed { justify-content: flex-start; }
    .needed ul { justify-content: flex-start; }
  }
</style>

<script>
  // Live leaderboard feed. The template above renders sampleLaps (from
  // ../data/leaderboard) at build time so the page always looks correct
  // even with JS disabled or before this script runs. This script then
  // tries to load real accepted runs from Supabase's public_leaderboard
  // view (the only public read of run data, see its comment in the schema)
  // and, only if at least one real row comes back, replaces the sample
  // rows with the real ones and drops the "Sample data" flag. If there are
  // zero real rows yet (pre-launch, no accepted submissions), the sample
  // data stays exactly as it is today -- nothing to configure or flip
  // later, this switches over on its own the first time a moderator
  // accepts a run.
  //
  // TRACK_ID is hardcoded because there is currently only one track
  // (Gellhorn). If a second track is ever added, this needs to become a
  // prop passed in from the page, same as the static copy above already
  // assumes a single track.
  import { createClient } from '@supabase/supabase-js';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
  const backendConfigured = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY);
  const TRACK_ID = 'gellhorn-international-raceway';

  function formatLapTime(ms: number): string {
    const minutes = Math.floor(ms / 60000);
    const seconds = Math.floor((ms % 60000) / 1000);
    const millis = ms % 1000;
    return `${minutes}:${String(seconds).padStart(2, '0')}.${String(millis).padStart(3, '0')}`;
  }

  function logoUrl(slug: string | null): string | null {
    if (!slug) return null;
    const base = import.meta.env.BASE_URL;
    return `${base}images/logos/${slug}-gta-6-logo.webp`;
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  interface LiveRow {
    driver: string;
    driver_id: string;
    vehicle_id: string | null;
    make: string;
    model: string;
    manufacturer_logo_slug: string | null;
    lap_time_ms: number;
    track_entries: number;
    video_verified: boolean;
    video_url: string | null;
  }

  // Crew tag next to the driver (RS-0024). public_crew_roster only lists
  // active members of published crews and never anonymised drivers.
  type CrewTag = { tag: string; color: string };
  function crewTag(t: CrewTag | undefined): string {
    if (!t || !/^#[0-9a-fA-F]{6}$/.test(t.color)) return '';
    return ` <span class="crew-tag crew-tag-sm lb-crew-tag" style="--crew-color:${t.color}" title="Crew tag ${escapeHtml(t.tag)}">${escapeHtml(t.tag)}</span>`;
  }

  function renderLiveRows(rows: LiveRow[], tags: Map<string, CrewTag> = new Map()) {
    const tbodyEl = document.getElementById('lb-tbody');
    if (!tbodyEl) return;

    const flagEl = document.getElementById('lb-flag');
    if (flagEl) flagEl.hidden = true;

    const metaEl = document.getElementById('lb-meta');
    if (metaEl) {
      const driverCount = new Set(rows.map((r) => r.driver)).size;
      metaEl.textContent = `Gellhorn International Raceway · PS5 · Current Standard · ${driverCount} driver${driverCount === 1 ? '' : 's'} · ${rows.length} accepted lap${rows.length === 1 ? '' : 's'}`;
    }

    const bestMs = rows[0].lap_time_ms;
    tbodyEl.innerHTML = rows
      .map((row, i) => {
        const rank = i + 1;
        const gapHtml =
          rank === 1
            ? ''
            : `<span class="lb-gap">+${((row.lap_time_ms - bestMs) / 1000).toFixed(3)}</span>`;
        const logo = logoUrl(row.manufacturer_logo_slug);
        const logoHtml = logo
          ? `<span class="logo-chip"><img src="${logo}" alt="${escapeHtml(row.make)} logo" width="20" height="20" loading="lazy" /></span>`
          : '';
        const statusHtml = row.video_verified
          ? `<span class="status-ok"><span class="check-circle"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span> Video verified</span>`
          : `<span class="status-pending"><span class="status-dot"></span> Not video verified</span>`;
        const videoHtml =
          row.video_verified && row.video_url
            ? `<a class="watch-btn outline-hover" href="${escapeHtml(row.video_url)}" target="_blank" rel="noopener" aria-label="Watch ${escapeHtml(row.driver)}'s lap">Watch</a>`
            : '—';

        return `
          <tr class="${rank <= 3 ? 'is-top3' : ''}">
            <td class="lb-rank">${rank}</td>
            <td class="lb-driver">${escapeHtml(row.driver)}${crewTag(tags.get(row.driver_id))}</td>
            <td>
              ${row.vehicle_id
                ? `<a class="lb-vehicle lb-vehicle-link" href="${import.meta.env.BASE_URL}garage/vehicles/${encodeURIComponent(row.vehicle_id)}/" title="${escapeHtml(row.make)} ${escapeHtml(row.model)} in The Garage">${logoHtml}<span class="lb-vehicle-name"><span class="lb-make">${escapeHtml(row.make)}</span> ${escapeHtml(row.model)}</span></a>`
                : `<span class="lb-vehicle">${logoHtml}<span class="lb-make">${escapeHtml(row.make)}</span> ${escapeHtml(row.model)}</span>`}
            </td>
            <td class="lb-num">${row.track_entries}</td>
            <td class="lb-time">${formatLapTime(row.lap_time_ms)}${gapHtml}</td>
            <td>${statusHtml}</td>
            <td class="lb-video">${videoHtml}</td>
          </tr>`;
      })
      .join('');
  }

  async function loadLiveLeaderboard() {
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const { data, error } = await sb
      .from('public_leaderboard')
      .select(
        'driver, driver_id, vehicle_id, make, model, manufacturer_logo_slug, lap_time_ms, track_entries, video_verified, video_url'
      )
      .eq('track_id', TRACK_ID)
      .order('lap_time_ms', { ascending: true });

    // Any error, or zero real rows (the normal pre-launch state): leave
    // the build-time sample data exactly as rendered. Only swap in once
    // there is at least one real accepted run to show.
    if (error || !data || data.length === 0) return;

    const rows = data as LiveRow[];
    const tags = new Map<string, CrewTag>();
    const ids = [...new Set(rows.map((r) => r.driver_id).filter(Boolean))];
    if (ids.length) {
      const roster = await sb.from('public_crew_roster').select('driver_id, tag, color').in('driver_id', ids.slice(0, 300));
      for (const r of (roster.data ?? []) as { driver_id: string; tag: string; color: string }[]) tags.set(r.driver_id, { tag: r.tag, color: r.color });
    }
    renderLiveRows(rows, tags);
  }

  if (backendConfigured) {
    loadLiveLeaderboard();
  }
</script>
