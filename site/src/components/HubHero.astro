---
// Shared image header for all /hub/ pages. Height and veil are kept in
// sync, literally, with the Garage and Gellhorn heroes (.hero-grid
// min-height 21rem / 35rem below 860px) so the band is identical across
// sections. Image: Visual/Cars/carmeet1.png (chosen by Fausto,
// 2026-09-25), resized to 640/1080/1672 px.
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}
const { eyebrow, title, lede } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <picture>
    <source type="image/webp" srcset={`${base}images/hub/hub-carmeet-640.webp 640w, ${base}images/hub/hub-carmeet-1080.webp 1080w, ${base}images/hub/hub-carmeet-1672.webp 1672w`} sizes="100vw" />
    <img src={`${base}images/hub/hub-carmeet-1672.jpg`} alt="" width="1672" height="940" loading="eager" fetchpriority="high" />
  </picture>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display hero-title">{title}</h1>
      <p class="hero-lede">{lede}</p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero picture, .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Crop: faces of the group on the left + both wrapped cars stay in
     view; mostly sky (top) and tarmac (bottom) get cut. */
  .hero img { object-position: 60% 45%; }
  .hero-veil { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(20,20,26,.97) 15%, rgba(20,20,26,.6) 60%, rgba(20,20,26,.85)); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1fr; /* no right-hand aside on hub pages */ align-items: center; gap: 2rem; min-height: 21rem; padding-block: 2rem; }
  .hero-copy { max-width: 46rem; align-self: start; }
  .hero-title { font-size: 2.5rem; margin: .5rem 0 .8rem; }
  .hero-lede { color: var(--gh-muted); font-size: 1rem; margin: 0; max-width: 56ch; }
  @media (max-width: 860px) {
    .hero-grid { min-height: 35rem; padding-block: 2.5rem; }
    .hero img { object-position: 58% 70%; }
  }
</style>
