---
interface Props { active?: 'leaderboard' | 'how-it-works' | 'rules' | null }
const { active = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'leaderboard', label: 'Leaderboard', href: `${base}tracks/gellhorn-international-raceway/#leaderboard` },
  { key: 'how-it-works', label: 'How It Works', href: `${base}time-attack/how-it-works/` },
  { key: 'rules', label: 'Rules', href: `${base}time-attack/rules/` },
];
---
<header class="site-head">
  <div class="wrap site-head-row">
    <a class="brand" href={base}>
      <span class="brand-main">GELLHORN</span><span class="brand-sub">TIME ATTACK</span>
    </a>
    <nav aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { 'is-active': active === l.key }]}>{l.label}</a>
      ))}
    </nav>
    <a class="btn btn-outline discord-btn" href="https://discord.gg/hPGuBwXRqT" target="_blank" rel="noopener">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 5.3A18 18 0 0 0 15.9 4l-.3.6a15 15 0 0 1 4 1.6 16 16 0 0 0-13.2 0 15 15 0 0 1 4-1.6L10.1 4a18 18 0 0 0-4.4 1.3C2.9 9 2.2 12.6 2.5 16.1a18 18 0 0 0 5.5 2.8l.8-1.3a11 11 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 9.2 0l.5.4a11 11 0 0 1-1.9.9l.8 1.3a18 18 0 0 0 5.5-2.8c.4-4-.7-7.5-2.2-10.8ZM9.3 14c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Zm5.4 0c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Z"/></svg>
      Join Discord
    </a>
  </div>
</header>

<style>
  .site-head { position: sticky; top: 0; z-index: 40; background: rgba(20,20,26,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--gh-line); }
  .site-head-row { display: flex; align-items: center; gap: 1.5rem; height: var(--gh-header-h); }
  .brand { display: inline-flex; gap: .35rem; align-items: baseline; text-decoration: none; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; letter-spacing: .01em; }
  .brand-main { color: var(--gh-text); font-size: .98rem; }
  .brand-sub { color: var(--gh-red); font-size: .98rem; }
  nav { display: flex; gap: 1.5rem; margin-left: .5rem; flex: 1; }
  .nav-link { color: var(--gh-muted); text-decoration: none; font-size: .78rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; padding-block: .3rem; border-bottom: 2px solid transparent; }
  .nav-link:hover { color: var(--gh-text); }
  .nav-link.is-active { color: var(--gh-text); border-color: var(--gh-red); }
  .discord-btn { padding: .5rem .9rem; gap: .45rem; font-size: .72rem; }
  @media (max-width: 760px) {
    nav { display: none; }
    .site-head-row { justify-content: space-between; }
  }
</style>
