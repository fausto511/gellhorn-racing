---
import '../styles/tokens.css';
import '../styles/fonts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  section?: 'time-attack' | 'garage' | 'hub' | 'account' | 'moderator' | null;
  noindex?: boolean;
}
const { title, description, section = null, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<!-- Inline dark background + color-scheme: the page never flashes white
     while the stylesheet is still loading on navigation (2026-09-26). -->
<html lang="en" style="background:#14141a;color-scheme:dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#14141a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <Header section={section} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
